<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Crash reports and analytics only. The app itself is fully offline by a
         locked decision: stations, geofences and TTS are all on device, and no
         ride has ever needed a network.

         DECLARED HERE, IN main, DELIBERATELY. Flutter puts INTERNET in the
         debug and profile manifests only, so a RELEASE build had no network
         permission at all and both Sentry and Aptabase would have failed
         silently in the one build that ships. Found 8 Aug 2026, before any
         release existed. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:label="commute_guardian"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <!-- THE NOTIFICATION SMALL ICON, and it is not the app icon.
             Android draws a small icon from its ALPHA CHANNEL ONLY, tinted to
             one colour. flutter_foreground_task falls back to appInfo.icon
             when none is named, and ic_launcher is 96 percent opaque, so the
             lock screen and the shade drew a solid white square instead of
             the logo. Reported from the 3T on 10 Sep 2026.
             Generated by tool/build_notification_icon.py; never hand-edited.
             The name here, the drawable, and the Dart NotificationIcon all
             have to agree. notification_icon_test.dart is what keeps them so. -->
        <meta-data
            android:name="com.ballshank.commute_guardian.TRAVEL_MODE_ICON"
            android:resource="@drawable/ic_stat_travel_mode" />

        <!-- Warning: Do not change service name (flutter_foreground_task requirement). -->
        <service
            android:name="com.pravera.flutter_foreground_task.service.ForegroundService"
            android:foregroundServiceType="location"
            android:exported="false" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
