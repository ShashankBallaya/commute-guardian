# Product strategy documents, deliberately kept out of the public repo
COMMUTE_GUARDIAN_HANDOVER.md
Commute-Guardian-Wireframes.pdf
CLAUDE.md

# Third-party agent skills (installed via `npx skills`), kept local only
.agents/
.claude/
.codex/
skills-lock.json

# OSM query cache for tool/build_stations.py (regenerate with the script)
tool/.osm_cache.json

# Personal Dart/Flutter learning workspace (/teach), not part of the app
teaching/

# Sarvam API key for tool/build_sarvam_clips.py, never commit
tool/.sarvam_key

# Build-time keys, never committed: this repository is public. Copy
# secrets.example.json to secrets.json and paste them in. Builds pass them with
# --dart-define-from-file=secrets.json; with no file, crash reporting and
# analytics are both off and the app runs normally. See docs/sentry.md and
# docs/analytics.md.
secrets.json

# The Play upload key. The keystore itself lives OUTSIDE this repository
# (see android/key.properties). Committing either one hands anybody who can
# read the repo the ability to publish as us.
/android/key.properties
*.jks
*.keystore
